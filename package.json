{
  "name": "glaux-website",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "i18n:compile": "node scripts/compile-i18n.ts",
    "pretypes:check": "pnpm i18n:compile",
    "types:check": "tsc --noEmit",
    "lint": "oxlint",
    "docs:sync": "node scripts/sync-glaux-docs.ts",
    "docs:pin": "node scripts/pin-glaux-docs.ts",
    "docs:check": "node scripts/check-glaux-docs.ts",
    "credits:sync": "node scripts/sync-credits.ts",
    "credits:check": "node scripts/sync-credits.ts --check",
    "predev": "pnpm docs:sync",
    "prebuild": "pnpm docs:sync",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy",
    "test:worker": "node scripts/smoke-worker.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@inlang/paraglide-js": "^2.29.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "1.5.0",
    "takumi-js": "^2.17.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "oxlint": "^1.88.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.154.0",
    "yaml": "2.9.1"
  }
}
